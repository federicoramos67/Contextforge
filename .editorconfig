# https://editorconfig.org
# Mantiene el mismo formato base entre editores, alineado con .prettierrc.json.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.md]
# Markdown usa dos espacios finales como salto de línea.
trim_trailing_whitespace = false

[*.py]
indent_size = 4
