# ContextForge — AI provider configuration / configuración de proveedores de IA
#
# Copy this file to .env and fill in the keys you have. One key is enough to
# enable AI mode; rules mode needs none.
# Copiá este archivo como .env y completá las keys que tengas. Con UNA key
# alcanza para activar el Modo IA; el modo reglas no necesita ninguna.
#
# ⚠️  SECURITY WARNING / ADVERTENCIA DE SEGURIDAD
#
# Vite inlines EVERY VITE_* variable into the JS bundle when you run
# `npm run build`. Never build for a PUBLIC deployment with keys in this file:
# they end up readable in plain text in the served JavaScript. For a public
# demo, build WITHOUT a .env — the local rules mode works with no keys.
#
# Vite embebe TODAS las variables VITE_* dentro del bundle JS al hacer
# `npm run build`. Nunca hagas un build para deploy PÚBLICO con keys en este
# archivo: quedarían expuestas en texto plano en el JS servido. Para una demo
# pública, buildeá SIN .env — el modo reglas locales funciona sin ninguna key.
#
# See SECURITY.md / ver SECURITY.es.md

# Mistral (free tier / capa gratuita) — https://console.mistral.ai
VITE_MISTRAL_KEY=

# Groq (generous free tier / capa gratuita generosa) — https://console.groq.com
VITE_GROQ_KEY=

# Google Gemini — https://aistudio.google.com
VITE_GEMINI_KEY=

# Anthropic — https://console.anthropic.com
# Local use only: the key is sent from the browser.
# Solo para uso local: la key se envía desde el navegador.
VITE_ANTHROPIC_KEY=

# OpenAI — https://platform.openai.com
VITE_OPENAI_KEY=

# Local Ollama — no key needed, only a URL / sin key, solo la URL
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3
