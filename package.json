{
  "name": "contextforge",
  "version": "0.6.0-alpha",
  "private": true,
  "type": "module",
  "description": "Local-first, bilingual (EN/ES) context engineering tool that recommends which files, formats and constraints to share with an AI before prompting it.",
  "keywords": [
    "ai",
    "prompt-engineering",
    "context-engineering",
    "local-first",
    "react",
    "vite",
    "i18n",
    "bilingual"
  ],
  "homepage": "https://federicoramos67.github.io/Contextforge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/federicoramos67/Contextforge.git"
  },
  "bugs": {
    "url": "https://github.com/federicoramos67/Contextforge/issues"
  },
  "license": "MIT",
  "author": "Federico Ramos (https://github.com/federicoramos67)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.5",
    "vitest": "^4.1.6"
  }
}
